{
  "name": "nyx-tv",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.worker.config.ts",
    "typecheck": "tsc --noEmit",
